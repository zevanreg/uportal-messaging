{
  "name": "uportal-messaging",
  "image": "mcr.microsoft.com/devcontainers/java:8",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "8",
      "installMaven": true,
      "additionalVersions": "21"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "vscjava.migrate-java-to-azure",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y git-lfs && git lfs install && mvn dependency:resolve"
}